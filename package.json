{
  "name": "followmeow",
  "version": "0.1.0",
  "description": "A cursor-following desktop cat for macOS and Windows.",
  "main": "dist/main/index.js",
  "scripts": {
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit",
    "art:normalize": "node scripts/normalize-cat-art.mjs",
    "icons:generate": "node scripts/generate-tray-icons.mjs",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json && node scripts/bundle-runtime.mjs && node scripts/copy-static.mjs",
    "test:runtime": "vitest run --run tests/runtime/bootstrap.test.ts",
    "test:runtime:clean": "npm run build && npm run test:runtime",
    "postinstall": "node scripts/ensure-electron.mjs",
    "start": "npm run build && electron .",
    "package:mac:x64": "electron-builder --mac --x64 --publish never",
    "package:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "package:win:x64": "electron-builder --win --x64 --publish never",
    "package:win:arm64": "electron-builder --win --arm64 --publish never",
    "verify:mac:x64": "node scripts/verify-macos-architecture.mjs x64",
    "verify:mac:arm64": "node scripts/verify-macos-architecture.mjs arm64",
    "verify:win:x64": "node scripts/verify-pe-architecture.mjs x64",
    "verify:win:arm64": "node scripts/verify-pe-architecture.mjs arm64"
  },
  "keywords": [
    "electron",
    "cursor",
    "cat",
    "desktop"
  ],
  "author": "subeomlee",
  "repository": {
    "type": "git",
    "url": "https://github.com/subeom/Followmeow.git"
  },
  "license": "GPL-2.0-only",
  "type": "commonjs",
  "build": {
    "appId": "com.subeom.Followmeow",
    "productName": "Followmeow",
    "asar": true,
    "electronLanguages": [
      "en",
      "ko"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "PRIVACY.md"
    ],
    "extraResources": [
      {
        "from": "resources/win-input-language.ps1",
        "to": "resources/win-input-language.ps1"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "PRIVACY.md",
        "to": "PRIVACY.md"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "electron@37.2.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
